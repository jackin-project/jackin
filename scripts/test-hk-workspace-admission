#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
hk_path=$(command -v hk)
hk_bin=$(mise --no-config --no-env --no-hooks --locked which --tool hk@2.8.0 hk)
[[ "$hk_path" == "$hk_bin" ]] || {
  printf '%s\n' 'the active Mise task PATH does not select its pinned hk 2.8.0 binary' >&2
  exit 1
}
[[ "$("$hk_bin" --version)" == 'hk 2.8.0' ]] || {
  printf '%s\n' 'workspace-admission tests require the pinned hk 2.8.0 binary' >&2
  exit 1
}

tmp_root=$(mktemp -d "${TMPDIR:-/tmp}/jackin-hk-workspace-admission.XXXXXX")
trap 'rm -rf "$tmp_root"' EXIT

fixture="$tmp_root/repo with spaces"
excluded_fixture="$tmp_root/excluded workspace"
invalid_fixture="$tmp_root/symlink manifest workspace"
outside="$tmp_root/outside workspace"
mock_bin="$tmp_root/mock bin"
missing_guard_bin="$tmp_root/missing guard bin"
bad_guard_bin="$tmp_root/non-executable guard bin"
mkdir -p "$fixture/crates/nested member/src" "$fixture/src" \
  "$excluded_fixture/crates/tools/jackin-lints/src" "$invalid_fixture/src" \
  "$outside" "$mock_bin" "$missing_guard_bin" "$bad_guard_bin"

install_config() {
  local destination=$1
  cp "$repo_root/hk.pkl" "$destination/hk.pkl"
  mkdir -p "$destination/scripts"
  cp "$repo_root/scripts/hk-workspace-admission" "$destination/scripts/"
  chmod +x "$destination/scripts/hk-workspace-admission"
  git -C "$destination" init -q
}

install_config "$fixture"
install_config "$excluded_fixture"
install_config "$invalid_fixture"
printf '%s\n' '[workspace]' 'members = ["crates/nested member"]' 'resolver = "3"' >"$fixture/Cargo.toml"
printf '%s\n' '[package]' 'name = "nested-member"' 'version = "0.1.0"' 'edition = "2024"' \
  >"$fixture/crates/nested member/Cargo.toml"
printf '%s\n' 'pub fn root_fixture() {}' >"$fixture/src/lib.rs"
printf '%s\n' 'pub fn nested_fixture() {}' >"$fixture/crates/nested member/src/lib.rs"
printf '%s\n' '[workspace]' >"$excluded_fixture/Cargo.toml"
printf '%s\n' 'pub fn excluded_fixture() {}' \
  >"$excluded_fixture/crates/tools/jackin-lints/src/lib.rs"
printf '%s\n' '[package]' 'name = "outside-fixture"' 'version = "0.1.0"' 'edition = "2024"' \
  >"$outside/Cargo.toml"
printf '%s\n' '[workspace]' >"$invalid_fixture/regular-Cargo.toml"
ln -s "$invalid_fixture/regular-Cargo.toml" "$invalid_fixture/Cargo.toml"
printf '%s\n' 'pub fn invalid_fixture() {}' >"$invalid_fixture/src/lib.rs"
git -C "$fixture" add .
git -C "$excluded_fixture" add .
git -C "$invalid_fixture" add .

cat >"$mock_bin/rust-build-guard" <<'MOCK_GUARD'
#!/usr/bin/env bash
set -euo pipefail
{
  printf 'cwd=%s\n' "$PWD"
  for argument in "$@"; do printf 'arg=%s\n' "$argument"; done
} >>"$HK_GUARD_LOG"
if [[ ${HK_GUARD_STATUS:-0} != 0 ]]; then exit "$HK_GUARD_STATUS"; fi
[[ ${1:-} == -- ]] || exit 92
shift
exec "$@"
MOCK_GUARD
cat >"$mock_bin/mise" <<'MOCK_MISE'
#!/usr/bin/env bash
set -euo pipefail
{
  printf 'cwd=%s\n' "$PWD"
  for argument in "$@"; do printf 'arg=%s\n' "$argument"; done
} >>"$HK_MISE_LOG"
[[ ${1:-} == exec && ${2:-} == -- && ${3:-} == cargo ]] || exit 93
shift 2
exec "$@"
MOCK_MISE
cat >"$mock_bin/cargo" <<'MOCK_CARGO'
#!/usr/bin/env bash
set -euo pipefail
{
  printf 'cwd=%s\n' "$PWD"
  for argument in "$@"; do printf 'arg=%s\n' "$argument"; done
} >>"$HK_CARGO_LOG"
if [[ "$*" == 'fmt --all --check -- --files-with-diff' ]]; then
  printf '%s\n' 'src/lib.rs'
fi
MOCK_CARGO
cat >"$bad_guard_bin/rust-build-guard" <<'BAD_GUARD'
#!/bin/sh
exit 0
BAD_GUARD
chmod +x "$mock_bin/rust-build-guard" "$mock_bin/mise" "$mock_bin/cargo"
chmod 644 "$bad_guard_bin/rust-build-guard"

guard_log="$tmp_root/guard.log"
mise_log="$tmp_root/mise.log"
cargo_log="$tmp_root/cargo.log"
expected_guard="$tmp_root/expected-guard.log"
expected_mise="$tmp_root/expected-mise.log"
expected_cargo="$tmp_root/expected-cargo.log"
clear_logs() {
  : >"$guard_log"
  : >"$mise_log"
  : >"$cargo_log"
}

append_expected() {
  local output=$1 cwd=$2
  shift 2
  printf 'cwd=%s\n' "$cwd" >>"$output"
  for argument in "$@"; do printf 'arg=%s\n' "$argument" >>"$output"; done
}

expect_cargo_command() {
  local cwd=$1
  shift
  append_expected "$expected_guard" "$cwd" -- mise exec -- cargo "$@"
  append_expected "$expected_mise" "$cwd" exec -- cargo "$@"
  append_expected "$expected_cargo" "$cwd" "$@"
}

run_hk() {
  local cwd=$1 path=${HK_TEST_PATH:-"$mock_bin:/usr/bin:/bin:/opt/homebrew/bin"}
  shift
  (
    cd "$cwd"
    env HK_MISE=0 HK_GUARD_STATUS="${HK_GUARD_STATUS:-0}" \
      HK_GUARD_LOG="$guard_log" HK_MISE_LOG="$mise_log" HK_CARGO_LOG="$cargo_log" \
      PATH="$path" "$hk_bin" --no-progress --jobs 1 "$@"
  )
}

assert_trace() {
  diff -u "$expected_guard" "$guard_log"
  diff -u "$expected_mise" "$mise_log"
  diff -u "$expected_cargo" "$cargo_log"
}

root=$(cd -P "$fixture" && pwd -P)
nested=$(cd -P "$fixture/crates/nested member" && pwd -P)

clear_logs
: >"$expected_guard"
: >"$expected_mise"
: >"$expected_cargo"
run_hk "$fixture" check --all --step cargo_fmt
expect_cargo_command "$nested" fmt --all --check
expect_cargo_command "$root" fmt --all --check
assert_trace

clear_logs
: >"$expected_guard"
: >"$expected_mise"
: >"$expected_cargo"
run_hk "$fixture" fix --all --step cargo_fmt --stage
expect_cargo_command "$nested" fmt --all
expect_cargo_command "$root" fmt --all
assert_trace

clear_logs
: >"$expected_guard"
: >"$expected_mise"
: >"$expected_cargo"
run_hk "$fixture" check --all --step cargo_check
expect_cargo_command "$nested" check --locked --quiet
expect_cargo_command "$root" check --locked --quiet
assert_trace

clear_logs
: >"$expected_guard"
: >"$expected_mise"
: >"$expected_cargo"
run_hk "$fixture" fix --all --step cargo_check
expect_cargo_command "$nested" fix --locked --allow-dirty --allow-staged --quiet
expect_cargo_command "$root" fix --locked --allow-dirty --allow-staged --quiet
assert_trace

clear_logs
: >"$expected_guard"
: >"$expected_mise"
: >"$expected_cargo"
run_hk "$fixture" check --all --step cargo_clippy
expect_cargo_command "$nested" clippy --locked --quiet
expect_cargo_command "$root" clippy --locked --quiet
assert_trace

clear_logs
: >"$expected_guard"
: >"$expected_mise"
: >"$expected_cargo"
run_hk "$fixture" fix --all --step cargo_clippy
expect_cargo_command "$nested" clippy --locked --fix --allow-dirty --allow-staged --quiet
expect_cargo_command "$root" clippy --locked --fix --allow-dirty --allow-staged --quiet
assert_trace

clear_logs
: >"$expected_guard"
: >"$expected_mise"
: >"$expected_cargo"
run_hk "$nested" check --all --step cargo_check
expect_cargo_command "$nested" check --locked --quiet
expect_cargo_command "$root" check --locked --quiet
assert_trace

for step in cargo_check cargo_clippy; do
  clear_logs
  run_hk "$excluded_fixture" check --all --step "$step"
  [[ ! -s "$guard_log" && ! -s "$mise_log" && ! -s "$cargo_log" ]] || {
    printf 'nightly-only step reached Cargo through hk: %s\n' "$step" >&2
    exit 1
  }
done

clear_logs
failure_status=0
HK_GUARD_STATUS=23 run_hk "$fixture" check --all --step cargo_check \
  >/dev/null 2>&1 || failure_status=$?
[[ $failure_status -ne 0 && -s "$guard_log" && ! -s "$mise_log" ]] || {
  printf '%s\n' 'hk did not stop before Mise when the guard exited 23' >&2
  exit 1
}

for path in "$missing_guard_bin:/usr/bin:/bin:/opt/homebrew/bin" \
  "$bad_guard_bin:/usr/bin:/bin:/opt/homebrew/bin"; do
  clear_logs
  failure_status=0
  HK_TEST_PATH="$path" run_hk "$fixture" check --all --step cargo_check \
    >/dev/null 2>&1 || failure_status=$?
  [[ $failure_status -ne 0 && ! -s "$guard_log" && ! -s "$mise_log" ]] || {
    printf '%s\n' 'hk did not fail closed for a missing or non-executable guard' >&2
    exit 1
  }
done

run_helper() {
  local path=$1 manifest=$2 status=$3
  shift 3
  (
    cd "$fixture"
    env HK_GUARD_STATUS="$status" HK_GUARD_LOG="$guard_log" HK_MISE_LOG="$mise_log" \
      HK_CARGO_LOG="$cargo_log" \
      PATH="$path" bash "$fixture/scripts/hk-workspace-admission" "$manifest" \
      -- mise exec -- cargo "$@"
  )
}

clear_logs
: >"$expected_guard"
: >"$expected_mise"
: >"$expected_cargo"
# The current Cargo step does not select check_list_files in ordinary fix mode.
# Exercise its configured command through the same admission helper and prefix contract.
run_helper "$mock_bin:/usr/bin:/bin:/opt/homebrew/bin" "$fixture/Cargo.toml" 0 \
  fmt --all --check -- --files-with-diff >/dev/null
expect_cargo_command "$root" fmt --all --check -- --files-with-diff
assert_trace

clear_logs
failure_status=0
run_helper "$mock_bin:/usr/bin:/bin:/opt/homebrew/bin" "$fixture/Cargo.toml" 23 \
  check --locked --quiet >/dev/null 2>&1 || failure_status=$?
[[ $failure_status -eq 23 && ! -s "$mise_log" ]] || {
  printf '%s\n' 'guard exit 23 did not propagate before Mise' >&2
  exit 1
}

for path in "$missing_guard_bin:/usr/bin:/bin:/opt/homebrew/bin" \
  "$bad_guard_bin:/usr/bin:/bin:/opt/homebrew/bin"; do
  clear_logs
  failure_status=0
  run_helper "$path" "$fixture/Cargo.toml" 0 check --locked --quiet \
    >/dev/null 2>&1 || failure_status=$?
  [[ $failure_status -eq 69 && ! -s "$mise_log" ]] || {
    printf '%s\n' 'missing or non-executable guard did not fail closed before Mise' >&2
    exit 1
  }
done

ln -s "$outside/Cargo.toml" "$fixture/linked-Cargo.toml"
mkdir "$fixture/linked-dir" "$fixture/linked-file"
ln -s "$outside/Cargo.toml" "$fixture/linked-file/Cargo.toml"
ln -s "$outside" "$fixture/escaped"
for invalid_manifest in \
  "$outside/Cargo.toml" \
  "$fixture/linked-Cargo.toml" \
  "$fixture/linked-dir/Cargo.toml" \
  "$fixture/linked-file/Cargo.toml" \
  "$fixture/escaped/Cargo.toml" \
  "$fixture/missing/Cargo.toml" \
  "$fixture/Cargo.toml.bak"; do
  clear_logs
  failure_status=0
  run_helper "$mock_bin:/usr/bin:/bin:/opt/homebrew/bin" "$invalid_manifest" 0 \
    check --locked --quiet \
    >/dev/null 2>&1 || failure_status=$?
  [[ $failure_status -eq 65 && ! -s "$guard_log" && ! -s "$mise_log" ]] || {
    printf 'unsafe manifest reached guard or Mise: %s\n' "$invalid_manifest" >&2
    exit 1
  }
done

clear_logs
failure_status=0
invalid_hk_stderr="$tmp_root/invalid-hk.stderr"
HK_TEST_PATH="$mock_bin:/usr/bin:/bin:/opt/homebrew/bin" \
  run_hk "$invalid_fixture" check --all --step cargo_check \
    >/dev/null 2>"$invalid_hk_stderr" || failure_status=$?
[[ $failure_status -ne 0 && ! -s "$guard_log" && ! -s "$mise_log" && \
  "$(<"$invalid_hk_stderr")" == *'expected a regular Cargo.toml inside this repository'* ]] || {
  printf '%s\n' 'hk did not reject a symlinked workspace Cargo.toml before the guard' >&2
  exit 1
}

printf '%s\n' 'Pinned hk workspace-admission parity tests passed'

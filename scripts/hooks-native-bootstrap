#!/bin/sh
set -eu
newline=$(printf '\nx')
newline=${newline%x}

fail() {
    printf 'error: native hook bootstrap: %s\n' "$1" >&2
    exit 1
}

physical_file() {
    candidate=$1
    case "$candidate" in /*) ;; *) candidate=$PWD/$candidate ;; esac
    hops=0
    while :; do
        directory=$(CDPATH='' cd -P "$(dirname "$candidate")" && pwd -P) || return 1
        candidate=$directory/$(basename "$candidate")
        [ -L "$candidate" ] || break
        hops=$((hops + 1))
        [ "$hops" -le 40 ] || return 1
        link=$(readlink "$candidate") || return 1
        case "$link" in /*) candidate=$link ;; *) candidate=$directory/$link ;; esac
    done
    [ -f "$candidate" ] || return 1
    printf '%s\n' "$candidate"
}

hash_file() {
    result=$(/usr/bin/shasum -a 256 "$1") || return 1
    printf '%s\n' "${result%% *}"
}

hash_if_present() {
    if [ -f "$1" ] && [ ! -L "$1" ]; then hash_file "$1"; else printf '%s\n' none; fi
}

if [ "$#" -ne 0 ]; then fail 'unexpected arguments'; fi
repo=$(git rev-parse --show-toplevel) || fail 'cannot locate repository root'
case "$repo" in *"$newline"*) fail 'repository path contains a newline' ;; esac
repo=$(CDPATH='' cd -P "$repo" && pwd -P) || fail 'cannot resolve repository root'
cd "$repo"
original_home=${HOME:-}
inherited_path=${PATH:-}
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_SHALLOW_FILE GIT_PREFIX
unset GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_ATTR_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0
export GIT_CONFIG_COUNT=4
export GIT_CONFIG_KEY_0=core.fsmonitor GIT_CONFIG_VALUE_0=false
export GIT_CONFIG_KEY_1=core.hooksPath GIT_CONFIG_VALUE_1=/dev/null
export GIT_CONFIG_KEY_2=core.attributesFile GIT_CONFIG_VALUE_2=/dev/null
export GIT_CONFIG_KEY_3=core.autocrlf GIT_CONFIG_VALUE_3=false
confirmed_root=$(git rev-parse --show-toplevel) || fail 'repository changes after clearing ambient Git overrides'
confirmed_root=$(CDPATH='' cd -P "$confirmed_root" && pwd -P) || fail 'cannot resolve confirmed repository root'
[ "$confirmed_root" = "$repo" ] || fail 'ambient Git overrides selected a different repository'
reviewed_tree=$(git write-tree) || fail 'cannot capture reviewed staged tree'
case "$reviewed_tree" in *[!0-9a-f]*|'') fail 'staged tree id is invalid' ;; esac
[ "${#reviewed_tree}" -eq 40 ] || [ "${#reviewed_tree}" -eq 64 ] || fail 'staged tree id has an unsupported length'
object_format=$(git rev-parse --show-object-format) || fail 'cannot determine repository object format'
case "$object_format" in sha1|sha256) ;; *) fail 'repository object format is unsupported' ;; esac

for reviewed_file in scripts/hooks-native-bootstrap scripts/hooks-install; do
    [ -f "$reviewed_file" ] && [ ! -L "$reviewed_file" ] || fail "$reviewed_file is not a physical regular file"
    expected=$(git rev-parse "$reviewed_tree:$reviewed_file") || fail "$reviewed_file is absent from the staged tree"
    actual=$(git hash-object --no-filters -- "$reviewed_file") || fail "cannot hash working $reviewed_file"
    [ "$expected" = "$actual" ] || fail "$reviewed_file differs from the staged tree"
done

guard=$(command -v rust-build-guard 2>/dev/null || true)
if [ -z "$guard" ] && [ -n "${HOME:-}" ] && { [ -e "$HOME/.local/bin/rust-build-guard" ] || [ -L "$HOME/.local/bin/rust-build-guard" ]; }; then
    guard=$HOME/.local/bin/rust-build-guard
fi
[ -n "$guard" ] || fail 'rust-build-guard is not installed'
guard=$(physical_file "$guard") || fail 'rust-build-guard is not a physical executable'
[ -x "$guard" ] || fail 'rust-build-guard is not executable'

mise=$(command -v mise 2>/dev/null || true)
[ -n "$mise" ] || fail 'mise is not available'
mise=$(physical_file "$mise") || fail 'mise is not a physical executable'
mise_directory=$(dirname "$mise")
jq=$(command -v jq 2>/dev/null) || fail 'jq is required to select the Cargo artifact safely'
tmp_parent=${TMPDIR:-/tmp}
umask 077
tmp_parent=$(CDPATH='' cd -P "$tmp_parent" && pwd -P) || fail 'cannot resolve physical temporary directory'
work=$(mktemp -d "$tmp_parent/jackin-native-bootstrap.XXXXXX") || fail 'cannot create private bootstrap directory'
scratch=$(mktemp -d "$tmp_parent/jackin-native-bootstrap-scratch.XXXXXX") || { rm -rf "$work"; fail 'cannot create private scratch directory'; }
chmod 700 "$work" "$scratch" || { rm -rf "$work" "$scratch"; fail 'cannot protect private directories'; }
provisioned=0
cleanup() {
    if [ "$provisioned" -eq 1 ]; then
        rm -rf "$work"
    else
        printf 'error: bootstrap evidence retained at %s\n' "$work" >&2
    fi
    rm -rf "$scratch"
}
clean_environment() {
    if [ -n "$original_home" ]; then
        /usr/bin/env -i PATH="$mise_directory:$inherited_path" HOME="$original_home" \
            USER="${USER:-}" LOGNAME="${LOGNAME:-}" TMPDIR="$tmp_parent" \
            LANG="${LANG:-C}" LC_ALL="${LC_ALL:-C}" TERM="${TERM:-}" \
            MISE_TRUSTED_CONFIG_PATHS="$source_root" MISE_AUTO_INSTALL=0 \
            MISE_EXEC_AUTO_INSTALL=false "$@"
    else
        /usr/bin/env -i PATH="$mise_directory:$inherited_path" \
            USER="${USER:-}" LOGNAME="${LOGNAME:-}" TMPDIR="$tmp_parent" \
            LANG="${LANG:-C}" LC_ALL="${LC_ALL:-C}" TERM="${TERM:-}" \
            MISE_TRUSTED_CONFIG_PATHS="$source_root" MISE_AUTO_INSTALL=0 \
            MISE_EXEC_AUTO_INSTALL=false "$@"
    fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
mkdir -m 700 "$work/evidence" "$scratch/template" || fail 'cannot create private bootstrap directories'
evidence=$work/evidence
source_root=$work/source
home=$scratch/home
mkdir -m 700 "$home" || fail 'cannot create private bootstrap home'
export HOME="$home"

objects=$(git rev-parse --path-format=absolute --git-path objects) || fail 'cannot resolve Git object store'
objects=$(CDPATH='' cd -P "$objects" && pwd -P) || fail 'cannot resolve physical Git object store'
git init --quiet --object-format="$object_format" --template="$scratch/template" "$source_root" || fail 'cannot create isolated source repository'
source_root=$(CDPATH='' cd -P "$source_root" && pwd -P) || fail 'cannot resolve private source path'
mkdir -p "$source_root/.git/objects/info" "$source_root/.git/info" || fail 'cannot prepare private Git metadata'
printf '%s\n' "$objects" > "$source_root/.git/objects/info/alternates"
printf '%s\n' '* -filter -ident -text -eol -working-tree-encoding' > "$source_root/.git/info/attributes"
chmod 600 "$source_root/.git/objects/info/alternates" "$source_root/.git/info/attributes"
git -C "$source_root" config core.attributesFile /dev/null
git -C "$source_root" config core.autocrlf false
git -C "$source_root" config core.hooksPath /dev/null
if git ls-tree -r "$reviewed_tree" | /usr/bin/awk '$1 == "160000" { found = 1 } END { exit !found }'; then
    fail 'reviewed source contains a submodule entry'
fi
git -C "$source_root" read-tree "$reviewed_tree" || fail 'cannot read reviewed tree into isolated index'
git -C "$source_root" checkout-index --all --prefix="$source_root/" || fail 'cannot materialize reviewed source tree'
bad_symlink=$(/usr/bin/find "$source_root" -path "$source_root/.git" -prune -o -type l -exec sh -c '
    source_root=$1
    link_path=$2
    [ "$link_path" = "$source_root/CLAUDE.md" ] || { printf x; exit 0; }
    [ "$(/usr/bin/readlink "$link_path")" = AGENTS.md ] || { printf x; exit 0; }
    [ -f "$source_root/AGENTS.md" ] && [ ! -L "$source_root/AGENTS.md" ] || { printf x; exit 0; }
    resolved=$(/bin/realpath "$link_path") || { printf x; exit 0; }
    [ "$resolved" = "$source_root/AGENTS.md" ] || printf x
' sh "$source_root" {} \;) || fail 'cannot enumerate reviewed source symlinks'
[ -z "$bad_symlink" ] || fail 'reviewed source contains an unsupported symlink'
source_tree=$(git -C "$source_root" write-tree) || fail 'cannot verify materialized source tree'
[ "$source_tree" = "$reviewed_tree" ] || fail 'isolated source tree differs from reviewed tree'
build_commit=$(printf '%s\n' 'Jackin native pre-commit owner bootstrap' | git -C "$source_root" -c user.name='Jackin bootstrap' -c user.email='jackin-bootstrap@localhost' -c commit.gpgsign=false commit-tree "$reviewed_tree") || fail 'cannot create private bootstrap commit'
git -C "$source_root" update-ref refs/heads/native-bootstrap "$build_commit" || fail 'cannot retain private bootstrap commit'
git -C "$source_root" symbolic-ref HEAD refs/heads/native-bootstrap || fail 'cannot select private bootstrap commit'
git -C "$source_root" ls-tree -r -z "$reviewed_tree" > "$evidence/source.inventory" || fail 'cannot record source inventory'

index_path=$(git rev-parse --path-format=absolute --git-path index) || fail 'cannot resolve live Git index'
index_digest=$(hash_if_present "$index_path") || fail 'cannot hash live Git index'
shared_path=$(git rev-parse --path-format=absolute --shared-index-path) || fail 'cannot resolve split index'
shared_digest=none
if [ -n "$shared_path" ]; then shared_digest=$(hash_file "$shared_path") || fail 'cannot hash active split index'; fi
printf 'index=%s\nshared-index=%s\n' "$index_digest" "$shared_digest" > "$evidence/index.snapshot"

pin=$(sed -n 's/^[[:space:]]*channel[[:space:]]*=[[:space:]]*"\([0-9][0-9.]*\)".*/\1/p' "$source_root/rust-toolchain.toml" | head -n 1)
[ -n "$pin" ] || fail 'staged rust-toolchain.toml has no exact numeric pin'
if [ -n "$original_home" ]; then export HOME="$original_home"; else unset HOME; fi
unset CARGO_TARGET_DIR CARGO_BUILD_BUILD_DIR CARGO_BUILD_TARGET
cargo_path=$(cd "$source_root" && clean_environment "$mise" exec -- /bin/sh -c 'command -v cargo') || fail 'cannot resolve configured MBX Cargo'
cargo_path=$(physical_file "$cargo_path") || fail 'configured MBX Cargo is not physical'
rustup_path=$(command -v rustup 2>/dev/null) || fail 'rustup is not available'
rustup_path=$(physical_file "$rustup_path") || fail 'rustup is not a physical executable'
rustc_path=$("$rustup_path" which --toolchain "$pin" rustc) || fail 'cannot resolve pinned rustc'
rustc_path=$(physical_file "$rustc_path") || fail 'pinned rustc is not physical'

printf '%s\0' "$guard" -- mise exec -- cargo build --locked -p jackin-xtask --bin jackin-precommit-owner --message-format=json-render-diagnostics > "$evidence/build.argv"
chmod 600 "$evidence/source.inventory" "$evidence/index.snapshot" "$evidence/build.argv"
if ! (cd "$source_root" && clean_environment "$guard" -- mise exec -- cargo build --locked -p jackin-xtask --bin jackin-precommit-owner --message-format=json-render-diagnostics) > "$evidence/build.jsonl" 2> "$evidence/build.stderr"; then
    fail 'guarded locked native owner build failed'
fi
chmod 600 "$evidence/build.jsonl" "$evidence/build.stderr"
manifest_path=$source_root/crates/tools/jackin-xtask/Cargo.toml
src_path=$source_root/crates/tools/jackin-xtask/src/precommit_owner_main.rs
cat > "$scratch/artifact-filter.jq" <<'JQ'
select(.reason == "compiler-artifact" and .manifest_path == $manifest and .target.name == "jackin-precommit-owner" and (.target.kind | index("bin") != null) and .target.src_path == $src and (.package_id | type == "string" and length > 0) and (.executable | type == "string")) | .executable
JQ
"$jq" -er --arg manifest "$manifest_path" --arg src "$src_path" -f "$scratch/artifact-filter.jq" "$evidence/build.jsonl" > "$scratch/targets" || fail 'Cargo JSON has no exact owner compiler artifact'
[ "$(wc -l < "$scratch/targets" | tr -d ' ')" -eq 1 ] || fail 'Cargo JSON has duplicate owner compiler artifacts'
target_path=$(physical_file "$(cat "$scratch/targets")") || fail 'built owner artifact is not physical'
[ -x "$target_path" ] || fail 'built owner artifact is not executable'

cargo_sha=$(hash_file "$cargo_path") || fail 'cannot hash configured Cargo'
rustc_sha=$(hash_file "$rustc_path") || fail 'cannot hash pinned rustc'
source_sha=$(hash_file "$evidence/source.inventory") || fail 'cannot hash source inventory'
build_sha=$(hash_file "$evidence/build.jsonl") || fail 'cannot hash Cargo transcript'
target_sha=$(hash_file "$target_path") || fail 'cannot hash owner executable'
printf '%s\n' "$cargo_path" > "$evidence/cargo.path"
printf '%s\n' "$rustc_path" > "$evidence/rustc.path"
printf '%s\n' "$target_path" > "$evidence/target.path"
chmod 600 "$evidence/cargo.path" "$evidence/rustc.path" "$evidence/target.path"
printf 'jackin-native-precommit-bootstrap/1\nreviewed-tree=%s\nbuild-commit=%s\nindex-sha256=%s\nsource-sha256=%s\ncargo-sha256=%s\nrustc-sha256=%s\nbuild-sha256=%s\ntarget-sha256=%s\n' \
    "$reviewed_tree" "$build_commit" "$(hash_file "$evidence/index.snapshot")" \
    "$source_sha" "$cargo_sha" "$rustc_sha" "$build_sha" "$target_sha" > "$evidence/request"
chmod 600 "$evidence/request"

if ! "$target_path" provision-reviewed-snapshot --bootstrap-root "$work" --repository "$repo" --reviewed-tree "$reviewed_tree" > "$scratch/provision.result"; then
    fail 'native owner rejected bootstrap evidence'
fi
chmod 600 "$scratch/provision.result" || fail 'cannot protect native owner response'
generation=$(sed -n '2p' "$scratch/provision.result")
[ "$(sed -n '1p' "$scratch/provision.result")" = 'jackin-native-precommit-generation/1' ] || fail 'native owner response header is invalid'
[ "$(wc -l < "$scratch/provision.result" | tr -d ' ')" = 2 ] || fail 'native owner response has an invalid line count'
printf 'jackin-native-precommit-generation/1\n%s\n' "$generation" > "$scratch/provision.canonical"
cmp -s "$scratch/provision.result" "$scratch/provision.canonical" || fail 'native owner response is not canonical'
case "$generation" in *[!0-9a-f]*|'') fail 'native owner generation id is invalid' ;; esac
[ "${#generation}" -eq 64 ] || fail 'native owner generation id has an unsupported length'
common_git_dir=$(git rev-parse --path-format=absolute --git-common-dir) || fail 'cannot resolve Git common directory'
common_git_dir=$(CDPATH='' cd -P "$common_git_dir" && pwd -P) || fail 'cannot resolve physical Git common directory'
case "$common_git_dir" in *"$newline"*) fail 'Git common directory contains a newline' ;; esac
owner_root=$common_git_dir/jackin-precommit-owner
generation_path=$owner_root/generations/$generation
manifest_file=$generation_path/install.manifest
owner_file=$generation_path/owner
[ -f "$manifest_file" ] && [ ! -L "$manifest_file" ] || fail 'published install manifest is not a regular file'
[ -f "$owner_file" ] && [ ! -L "$owner_file" ] && [ -x "$owner_file" ] || fail 'published owner is not an executable regular file'
manifest_owner_hash=$(hash_file "$owner_file") || fail 'cannot hash published owner executable'
printf 'jackin-native-precommit-install/1\ngeneration=%s\nowner-sha256=%s\nsource-tree=%s\nbuild-commit=%s\nsource-sha256=%s\ncargo-sha256=%s\nrustc-sha256=%s\ntarget-sha256=%s\nbuild-sha256=%s\n' \
    "$generation" "$manifest_owner_hash" "$reviewed_tree" "$build_commit" \
    "$source_sha" "$cargo_sha" "$rustc_sha" "$target_sha" "$build_sha" > "$scratch/manifest.expected"
cmp -s "$manifest_file" "$scratch/manifest.expected" || fail 'published install manifest differs from verified build evidence'
[ "$(CDPATH='' cd -P "$generation_path" && pwd -P)" = "$generation_path" ] || fail 'published generation path traverses a symlink'
case "$generation_path" in *"$newline"*) fail 'generation path contains a newline' ;; esac
printf '%s\n' "$generation_path"
provisioned=1

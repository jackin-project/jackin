#!/bin/sh
set -eu
newline=$(printf '\nx')
newline=${newline%x}
# shellcheck disable=SC2016 # Keep sed program literal; expansion would corrupt its escapes.
shell_escape_sed='s/\\/\\\\/g; s/"/\\"/g; s/\$/\\$/g; s/`/\\`/g'

unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_SHALLOW_FILE GIT_PREFIX
unset GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if [ "$(git config --local --bool --get extensions.worktreeConfig 2>/dev/null || true)" != true ]; then
    printf '%s\n' 'error: extensions.worktreeConfig must be enabled before installing hooks; no migration was performed' >&2
    exit 1
fi

if [ ! -f scripts/hooks-native-bootstrap ] || [ -L scripts/hooks-native-bootstrap ]; then
    printf '%s\n' 'error: reviewed native hook bootstrap is missing or unsafe' >&2
    exit 1
fi
if ! generation_path=$(sh scripts/hooks-native-bootstrap); then
    printf '%s\n' 'error: native hook provisioning failed; hook registration was not changed' >&2
    exit 1
fi
case "$generation_path" in
    /*) ;;
    *) printf '%s\n' 'error: native hook provisioner returned a non-absolute generation path' >&2; exit 1 ;;
esac
case "$generation_path" in *"$newline"*)
    printf '%s\n' 'error: native hook provisioner returned a multiline generation path' >&2
    exit 1
    ;;
esac
[ -f "$generation_path/owner" ] && [ ! -L "$generation_path/owner" ] && [ -x "$generation_path/owner" ] || {
    printf '%s\n' 'error: provisioned immutable owner is missing or unsafe' >&2
    exit 1
}
shell_quote() {
    printf '"'
    printf '%s' "$1" | sed "$shell_escape_sed"
    printf '"'
}
owner_command="$(shell_quote "$generation_path/owner") run-installed-snapshot $(shell_quote "$generation_path")"

# Named-hook disabling must work independently of the actual event policy.
for enabled in true false; do
    if ! probe=$(git -c hook.jackin-capability-probe.event=jackin-capability-event \
        -c hook.jackin-capability-probe.command=: \
        -c hook.jackin-capability-probe.enabled="$enabled" \
        -c hook.jackin-capability-event.enabled=true \
        hook list --allow-unknown-hook-name jackin-capability-event); then
        printf '%s\n' 'error: Git with config-based named-hook disabling is required' >&2
        exit 1
    fi
    expected=jackin-capability-probe
    if [ "$enabled" = false ]; then
        expected=$(printf 'disabled\tjackin-capability-probe')
    fi
    if [ "$probe" != "$expected" ]; then
        printf '%s\n' 'error: Git does not enforce config-based named-hook disabling' >&2
        exit 1
    fi
done

# Preserve common and global hooks for other worktrees/repositories while owning this checkout's boundary.
config_path=$(git rev-parse --path-format=absolute --git-path config.worktree)
case "$config_path" in *"$newline"*)
    printf '%s\n' 'error: local Git config path contains a newline' >&2
    exit 1
    ;;
esac
if [ -e "$config_path" ] || [ -L "$config_path" ]; then
    [ -f "$config_path" ] && [ ! -L "$config_path" ] || {
        printf '%s\n' 'error: local Git config is not a regular file' >&2
        exit 1
    }
fi
config_lock=$config_path.lock
config_candidate=
config_committed=0
umask 077
set -C
if ! : > "$config_lock"; then
    set +C
    printf '%s\n' 'error: another Git config update is active or the config lock is unsafe' >&2
    exit 1
fi
set +C
cleanup_config() {
    if [ "$config_committed" -ne 1 ]; then rm -f "$config_lock"; fi
    if [ -n "$config_candidate" ]; then rm -f "$config_candidate"; fi
}
trap cleanup_config EXIT
trap 'exit 1' HUP INT TERM

# Keep the Git-compatible lock inode and its inherited mode/ACL for the final rename.
if [ -f "$config_path" ]; then
    [ ! -L "$config_path" ] || {
        printf '%s\n' 'error: local Git config became a symlink' >&2
        exit 1
    }
    cp -p "$config_path" "$config_lock" || {
        printf '%s\n' 'error: cannot preserve local Git config metadata' >&2
        exit 1
    }
fi
[ -f "$config_lock" ] && [ ! -L "$config_lock" ] || {
    printf '%s\n' 'error: local Git config lock is unsafe' >&2
    exit 1
}
config_candidate=$(mktemp "${config_path}.candidate.XXXXXX") || {
    printf '%s\n' 'error: cannot create local Git config candidate' >&2
    exit 1
}
if [ -f "$config_path" ]; then
    cp -p "$config_path" "$config_candidate" || {
        printf '%s\n' 'error: cannot copy local Git config candidate' >&2
        exit 1
    }
fi
git_config() {
    git config --file "$config_candidate" "$@"
}

git_config --replace-all hook.hk-pre-commit.enabled false

for key in hook.hk-pre-commit.command hook.hk-pre-commit.event; do
    if git_config --unset-all "$key" >/dev/null 2>&1; then
        :
    else
        status=$?
        if [ "$status" -ne 5 ]; then
            exit "$status"
        fi
    fi
done

git_config --replace-all hook.jackin-pre-commit.command "$owner_command"
git_config --replace-all hook.jackin-pre-commit.event pre-commit
git_config --replace-all hook.jackin-pre-commit.enabled true

git_config --replace-all hook.hk-pre-push.enabled false

for key in hook.hk-pre-push.command hook.hk-pre-push.event; do
    if git_config --unset-all "$key" >/dev/null 2>&1; then
        :
    else
        status=$?
        if [ "$status" -ne 5 ]; then
            exit "$status"
        fi
    fi
done

git_config --replace-all hook.jackin-pre-push.command 'sh scripts/pre-push-security'
git_config --replace-all hook.jackin-pre-push.event pre-push
git_config --replace-all hook.jackin-pre-push.enabled true

for key_expected in \
    'hook.hk-pre-commit.enabled=false' \
    "hook.jackin-pre-commit.command=$owner_command" \
    'hook.jackin-pre-commit.event=pre-commit' \
    'hook.jackin-pre-commit.enabled=true' \
    'hook.hk-pre-push.enabled=false' \
    'hook.jackin-pre-push.command=sh scripts/pre-push-security' \
    'hook.jackin-pre-push.event=pre-push' \
    'hook.jackin-pre-push.enabled=true'; do
    key=${key_expected%%=*}
    expected_value=${key_expected#*=}
    actual_value=$(git_config --includes --get-all "$key") || {
        printf 'error: staged local Git config is missing %s\n' "$key" >&2
        exit 1
    }
    [ "$actual_value" = "$expected_value" ] || {
        printf 'error: staged local Git config has an invalid %s\n' "$key" >&2
        exit 1
    }
done

# Admit the selected config leaf and its held Git lock through native ACL checks.
if ! "$generation_path/owner" validate-hook-config --repository "$repo_root" >/dev/null; then
    printf '%s\n' 'error: local Git config or lock failed native custody validation' >&2
    exit 1
fi

# Sync the completed lock, then rename and sync its held parent directory.
cat "$config_candidate" > "$config_lock" || {
    printf '%s\n' 'error: cannot write the complete local Git config lock' >&2
    exit 1
}
if "$generation_path/owner" activate-hook-config --repository "$repo_root" >/dev/null; then
    config_committed=1
else
    activation_status=$?
    if [ "$activation_status" -eq 2 ]; then config_committed=1; fi
    printf '%s\n' 'error: cannot complete synced local Git config activation' >&2
    exit 1
fi
rm -f "$config_candidate"
config_candidate=
trap - EXIT HUP INT TERM

if [ "$(git config --get hook.jackin-pre-push.command)" != 'sh scripts/pre-push-security' ] ||
    [ "$(git config --get hook.jackin-pre-push.event)" != pre-push ] ||
    [ "$(git config --get hook.jackin-pre-push.enabled)" != true ] ||
    [ "$(git config --get hook.hk-pre-push.enabled)" != false ]; then
    printf '%s\n' 'error: pre-push must enable the pinned Jackin launcher and disable direct hk' >&2
    exit 1
fi

effective=$(git hook list pre-commit)
if [ "$(git config --get hook.jackin-pre-commit.command)" != "$owner_command" ] ||
    ! printf '%s\n' "$effective" | grep -Fx 'jackin-pre-commit' >/dev/null ||
    printf '%s\n' "$effective" | grep -Fx 'hk-pre-commit' >/dev/null; then
    printf '%s\n' 'error: pre-commit must enable Jackin snapshot ownership and disable direct hk' >&2
    exit 1
fi

# Owner hk standard: use the locked launcher for the repository pre-push scan.
effective=$(git hook list pre-push)
if ! printf '%s\n' "$effective" | grep -Fx 'jackin-pre-push' >/dev/null ||
    printf '%s\n' "$effective" | grep -Fx 'hk-pre-push' >/dev/null; then
    printf '%s\n' 'error: pre-push must enable the pinned Jackin launcher and disable direct hk' >&2
    exit 1
fi

printf '%s\n' "installed Jackin staged-snapshot pre-commit and pinned pre-push hooks"

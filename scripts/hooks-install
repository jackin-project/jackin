#!/bin/sh
set -eu

unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_SHALLOW_FILE GIT_PREFIX
unset GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
guard=$(command -v rust-build-guard 2>/dev/null || true)
if [ -z "$guard" ] && [ -n "${HOME:-}" ] && [ -x "$HOME/.local/bin/rust-build-guard" ]; then
    guard=$HOME/.local/bin/rust-build-guard
fi
[ -n "$guard" ] || { printf '%s\n' 'error: rust-build-guard is required' >&2; exit 1; }

exec "$guard" -- mise exec -- cargo run --locked \
    -p jackin-xtask --bin jackin-precommit-owner -- install-hooks

#!/usr/bin/env python3
"""Exercise pinned secret scanners on disposable, single-commit fixtures."""

from __future__ import annotations

import json
import os
import re
import subprocess
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
SYNTHETIC_ID = "m-0123456789abcdef"
SYNTHETIC_PEM = "A" * 96
GLOBAL_CONFIG = os.devnull


def run(command: list[str], *, cwd: Path, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        cwd=cwd,
        env=env,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


def git(fixture: Path, *arguments: str) -> subprocess.CompletedProcess[str]:
    result = run(
        ["git", *arguments],
        cwd=fixture,
        env={
            **os.environ,
            "GIT_CONFIG_GLOBAL": GLOBAL_CONFIG,
            "GIT_CONFIG_SYSTEM": GLOBAL_CONFIG,
            "GIT_CONFIG_NOSYSTEM": "1",
        },
    )
    assert result.returncode == 0, f"git fixture setup failed ({result.returncode})"
    return result


def make_repo(parent: Path, name: str, files: dict[str, str]) -> Path:
    fixture = parent / name
    fixture.mkdir()
    git(fixture, "init", "-q")
    git(fixture, "config", "user.name", "Jackin scanner fixture")
    git(fixture, "config", "user.email", "jackin-scanner-fixture@example.invalid")
    for relative, contents in files.items():
        path = fixture / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(contents)
    git(fixture, "add", "--", ".")
    git(fixture, "commit", "-q", "-m", "synthetic scanner fixture")
    return fixture


def write_report(fixture: Path, scanner: str, arguments: list[str]) -> list[dict[str, object]]:
    report_path = fixture / f"{scanner}-report.json"
    command = ["mise", "exec", "--locked", "--", scanner, *arguments]
    command.extend(["--report-format", "json", "--report-path", str(report_path)])
    result = run(command, cwd=fixture)
    assert result.returncode in (0, 1), f"{scanner} synthetic scan failed ({result.returncode})"
    if not report_path.exists():
        assert result.returncode == 0, f"{scanner} did not write its finding report"
        return []
    report = json.loads(report_path.read_text())
    assert isinstance(report, list), f"{scanner} report format changed"
    assert bool(report) == (result.returncode == 1), f"{scanner} exit code disagrees with its findings"
    return report


def manifest(field: str, value: str) -> str:
    return json.dumps({field: value}, separators=(",", ":")) + "\n"


def make_gitleaks_repo(parent: Path, name: str, path: str, contents: str) -> Path:
    return make_repo(
        parent,
        name,
        {".gitleaks.toml": (ROOT / ".gitleaks.toml").read_text(), path: contents},
    )


def generic_findings(report: list[dict[str, object]]) -> list[dict[str, object]]:
    return [finding for finding in report if finding.get("RuleID") == "generic-api-key"]


def test_gitleaks_allowlist(parent: Path) -> None:
    target = ".github/velnor/task-execution-manifest-v1.json"
    raw = make_gitleaks_repo(parent, "gitleaks-unallowlisted", target, manifest("matrix_key", SYNTHETIC_ID))
    (raw / ".gitleaks.toml").write_text(
        re.sub(r"\[\[allowlists\]\].*\Z", "", (raw / ".gitleaks.toml").read_text(), flags=re.S)
    )
    raw_hits = generic_findings(write_report(raw, "gitleaks", ["git", ".", "--no-banner"]))
    assert len(raw_hits) == 1, "pinned Gitleaks default rule did not detect synthetic matrix key"
    assert raw_hits[0].get("Match") == f'matrix_key":"{SYNTHETIC_ID}"', (
        "pinned Gitleaks match spelling changed"
    )

    allowed = make_gitleaks_repo(parent, "gitleaks-matrix-allowed", target, manifest("matrix_key", SYNTHETIC_ID))
    assert generic_findings(write_report(allowed, "gitleaks", ["git", ".", "--no-banner"])) == []

    api = make_gitleaks_repo(parent, "gitleaks-api-key-not-allowed", target, manifest("api_key", SYNTHETIC_ID))
    api_hits = generic_findings(write_report(api, "gitleaks", ["git", ".", "--no-banner"]))
    assert len(api_hits) == 1, "allowlist suppressed a same-file api_key synthetic finding"
    assert api_hits[0].get("Match") == f'api_key":"{SYNTHETIC_ID}"', (
        "pinned Gitleaks api_key match spelling changed"
    )

    other_path = make_gitleaks_repo(
        parent,
        "gitleaks-other-path",
        ".github/velnor/other.json",
        manifest("matrix_key", SYNTHETIC_ID),
    )
    assert len(generic_findings(write_report(other_path, "gitleaks", ["git", ".", "--no-banner"]))) == 1

    changed_shape = make_gitleaks_repo(
        parent,
        "gitleaks-changed-shape",
        target,
        manifest("matrix_key", f"{SYNTHETIC_ID}0"),
    )
    assert len(generic_findings(write_report(changed_shape, "gitleaks", ["git", ".", "--no-banner"]))) == 1

    private_key_fixture = make_gitleaks_repo(
        parent,
        "gitleaks-other-rule",
        target,
        '{"matrix_key":"'
        + SYNTHETIC_ID
        + '","private_key":"-----BEGIN RSA PRIVATE KEY-----\n'
        + SYNTHETIC_PEM
        + '\n-----END RSA PRIVATE KEY-----"}\n',
    )
    report = write_report(private_key_fixture, "gitleaks", ["git", ".", "--no-banner"])
    assert generic_findings(report) == [], "matrix_key allowlist failed to suppress its intended rule"
    assert any(finding.get("RuleID") == "private-key" for finding in report), (
        "matrix_key allowlist suppressed a different rule"
    )


def betterleaks_config(allowlist: bool) -> str:
    # Betterleaks' default rule does not detect this short generated ID. This
    # test-only rule emits the pinned scanner's match shape to exercise the
    # actual allowlist engine; it is not evidence of production-rule detection.
    config = "[extend]\nuseDefault = false\n"
    test_rule = (
        "\n[[rules]]\n"
        'id = "generic-api-key"\n'
        'description = "synthetic match-shape rule; not a production detection rule"\n'
        "regex = '''(?:api_key|key)\":\"(?P<secret>m-[0-9a-f]+)\"'''\n"
        "secretGroup = 1\n"
        "entropy = 0\n"
    )
    if allowlist:
        production_allowlist = (ROOT / ".gitleaks.toml").read_text()
        config += test_rule + production_allowlist[production_allowlist.index("[[allowlists]]") :]
    else:
        config += test_rule
    return config


def make_betterleaks_repo(
    parent: Path, name: str, path: str, contents: str, *, allowlist: bool
) -> Path:
    return make_repo(
        parent,
        name,
        {
            ".gitleaks.toml": betterleaks_config(allowlist),
            path: contents,
        },
    )


def test_betterleaks_allowlist(parent: Path) -> None:
    target = ".github/velnor/task-execution-manifest-v1.json"
    raw = make_betterleaks_repo(
        parent, "betterleaks-unallowlisted", target, manifest("matrix_key", SYNTHETIC_ID), allowlist=False
    )
    raw_hits = generic_findings(write_report(raw, "betterleaks", ["git", ".", "--confidence", "low"]))
    assert len(raw_hits) == 1, "test-only Betterleaks rule did not emit the matrix match"
    assert raw_hits[0].get("Match") == f'key":"{SYNTHETIC_ID}"', (
        "pinned Betterleaks match spelling changed"
    )

    allowed = make_betterleaks_repo(
        parent, "betterleaks-matrix-allowed", target, manifest("matrix_key", SYNTHETIC_ID), allowlist=True
    )
    assert generic_findings(write_report(allowed, "betterleaks", ["git", ".", "--confidence", "low"])) == []

    api = make_betterleaks_repo(
        parent, "betterleaks-api-key-not-allowed", target, manifest("api_key", SYNTHETIC_ID), allowlist=True
    )
    api_hits = generic_findings(write_report(api, "betterleaks", ["git", ".", "--confidence", "low"]))
    assert len(api_hits) == 1, "allowlist suppressed a same-file api_key synthetic finding"
    assert api_hits[0].get("Match") == f'api_key":"{SYNTHETIC_ID}"', (
        "pinned Betterleaks api_key match spelling changed"
    )

    other_path = make_betterleaks_repo(
        parent,
        "betterleaks-other-path",
        ".github/velnor/other.json",
        manifest("matrix_key", SYNTHETIC_ID),
        allowlist=True,
    )
    other_hits = generic_findings(write_report(other_path, "betterleaks", ["git", ".", "--confidence", "low"]))
    assert len(other_hits) == 1, "allowlist escaped its generated-manifest path"
    assert other_hits[0].get("Match") == f'key":"{SYNTHETIC_ID}"'

    changed_shape = make_betterleaks_repo(
        parent,
        "betterleaks-changed-shape",
        target,
        manifest("matrix_key", f"{SYNTHETIC_ID}0"),
        allowlist=True,
    )
    changed_hits = generic_findings(write_report(changed_shape, "betterleaks", ["git", ".", "--confidence", "low"]))
    assert len(changed_hits) == 1, "allowlist accepted a value outside its exact 16-hex shape"


def test_audit_tool_provenance(parent: Path) -> None:
    config = (ROOT / "hk.pkl").read_text()
    audit_commands = [
        "mise exec --locked -- kingfisher scan . --git-history full --confidence low --no-validate --redact --no-update-check --baseline-file .kingfisher-baseline.yml",
        "mise exec --locked -- betterleaks git . --redact",
        "mise exec --locked -- gitleaks git . --redact --no-banner",
    ]
    for command in audit_commands:
        assert command in config, "a security-audit scanner no longer selects its locked tool"

    fixture = parent / "audit-provenance"
    fixture.mkdir()
    git(fixture, "init", "-q")
    git(fixture, "config", "user.name", "Jackin audit fixture")
    git(fixture, "config", "user.email", "jackin-audit-fixture@example.invalid")
    for name in ("hk.pkl", ".gitleaks.toml", ".kingfisher-baseline.yml"):
        (fixture / name).write_bytes((ROOT / name).read_bytes())
    for name in (".gitleaksignore", ".betterleaksignore"):
        source = ROOT / name
        if source.exists():
            (fixture / name).write_bytes(source.read_bytes())
    git(fixture, "add", "--", ".")
    git(fixture, "commit", "-q", "-m", "locked audit fixture")

    fake_bin = parent / "ambient-bin"
    fake_bin.mkdir()
    markers = parent / "ambient-scanners-ran"
    for scanner in ("kingfisher", "betterleaks", "gitleaks"):
        executable = fake_bin / scanner
        executable.write_text(
            "#!/bin/sh\n"
            "set -eu\n"
            f"printf '%s\\n' {scanner} >> \"$AMBIENT_MARKER\"\n"
            "exit 97\n"
        )
        executable.chmod(0o755)

    hk_path_result = run(["mise", "which", "hk"], cwd=ROOT)
    assert hk_path_result.returncode == 0, "could not resolve pinned HK executable"
    hk_path = hk_path_result.stdout.strip()
    environment = {
        **os.environ,
        "PATH": f"{fake_bin}{os.pathsep}{os.environ['PATH']}",
        "AMBIENT_MARKER": str(markers),
        "GIT_CONFIG_GLOBAL": GLOBAL_CONFIG,
        "GIT_CONFIG_SYSTEM": GLOBAL_CONFIG,
        "GIT_CONFIG_NOSYSTEM": "1",
    }
    result = run([hk_path, "run", "security-audit"], cwd=fixture, env=environment)
    assert result.returncode == 0, f"locked security audit failed in clean synthetic repo ({result.returncode})"
    assert not markers.exists(), "ambient scanner shim bypassed mise exec --locked"


def main() -> None:
    version_checks = {
        "gitleaks": "8.30.1",
        "betterleaks": "1.9.0",
    }
    for tool, expected in version_checks.items():
        result = run(["mise", "exec", "--locked", "--", tool, "version"], cwd=ROOT)
        assert result.returncode == 0 and expected in result.stdout, f"unexpected pinned {tool} version"

    with tempfile.TemporaryDirectory(prefix="jackin-security-audit.", dir=ROOT) as temporary:
        parent = Path(temporary)
        test_gitleaks_allowlist(parent)
        test_betterleaks_allowlist(parent)
        test_audit_tool_provenance(parent)

    print("pinned security-audit synthetic fixtures passed")


if __name__ == "__main__":
    main()

#!/bin/sh
set -eu

die() {
    printf 'error: %s\n' "$1" >&2
    exit 1
}

common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || die 'cannot resolve the Git common directory'
common_dir=$(CDPATH= cd -P "$common_dir" 2>/dev/null && pwd -P) || die 'cannot resolve the physical Git common directory'
install_root="$common_dir/jackin-precommit-owner"
active="$install_root/active"
[ -f "$active" ] && [ ! -L "$active" ] || die 'native pre-commit owner is not installed; run the reviewed native hook installer'

exec 3< "$active" || die 'cannot open the active native hook generation'
IFS= read -r generation <&3 || die 'active native hook generation is malformed'
if IFS= read -r extra <&3; then
    die 'active native hook generation must contain one record'
fi
exec 3<&-
case "$generation" in
    *[!0-9a-f]*|'') die 'active native hook generation is not lowercase hexadecimal' ;;
esac
[ "${#generation}" -eq 64 ] || die 'active native hook generation has the wrong length'

generation_dir="$install_root/generations/$generation"
physical_generation=$(CDPATH= cd -P "$generation_dir" 2>/dev/null && pwd -P) || die 'selected native hook generation is missing'
[ "$physical_generation" = "$generation_dir" ] || die 'selected native hook generation is not physical'
manifest="$physical_generation/install.manifest"
owner="$physical_generation/owner"
[ -f "$manifest" ] && [ ! -L "$manifest" ] || die 'selected native hook manifest is missing or unsafe'
[ -f "$owner" ] && [ ! -L "$owner" ] && [ -x "$owner" ] || die 'selected native hook owner is missing or unsafe'

exec 4< "$manifest" || die 'cannot open selected native hook manifest'
IFS= read -r header <&4 || die 'selected native hook manifest is malformed'
IFS= read -r manifest_generation <&4 || die 'selected native hook manifest lacks its generation'
IFS= read -r expected_hash <&4 || die 'selected native hook manifest lacks its owner hash'
exec 4<&-
[ "$header" = 'jackin-native-precommit-install/1' ] || die 'selected native hook manifest has an unsupported format'
[ "$manifest_generation" = "generation=$generation" ] || die 'selected native hook manifest generation mismatch'
case "$expected_hash" in
    owner-sha256=????????????????????????????????????????????????????????????????) ;;
    *) die 'selected native hook owner hash is malformed' ;;
esac
expected_hash=${expected_hash#owner-sha256=}
case "$expected_hash" in
    *[!0-9a-f]*) die 'selected native hook owner hash is not lowercase hexadecimal' ;;
esac

if [ -x /usr/bin/shasum ]; then
    actual_hash=$(/usr/bin/shasum -a 256 "$owner") || die 'cannot hash selected native hook owner'
elif [ -x /usr/bin/sha256sum ]; then
    actual_hash=$(/usr/bin/sha256sum "$owner") || die 'cannot hash selected native hook owner'
else
    die 'no supported system SHA-256 utility is available'
fi
actual_hash=${actual_hash%% *}
[ "$actual_hash" = "$expected_hash" ] || die 'selected native hook owner hash mismatch'

exec "$owner" run-installed-snapshot "$physical_generation" "$@"

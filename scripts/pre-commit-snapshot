#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

stash_ref=
patch_file=
archive_file=

restore_worktree() {
    hook_status=$?
    trap - EXIT HUP INT TERM

    if [ -n "$stash_ref" ]; then
        patch_file=$(mktemp "/tmp/jackin-pre-commit.XXXXXX")
        if ! git diff --binary "$stash_ref^2" "$stash_ref" > "$patch_file"; then
            printf '%s\n' "error: failed to read the pre-commit snapshot; stash retained at $stash_ref" >&2
            exit 1
        fi
        if [ -s "$patch_file" ]; then
            if ! git apply --binary --whitespace=nowarn "$patch_file"; then
                printf '%s\n' "error: failed to restore unstaged tracked work; stash retained at $stash_ref" >&2
                exit 1
            fi
        fi

        untracked_tree=$(git rev-parse --verify --quiet "$stash_ref^3" 2>/dev/null || true)
        if [ -n "$untracked_tree" ]; then
            archive_file=$(mktemp "/tmp/jackin-pre-commit.XXXXXX")
            if ! git archive --format=tar "$untracked_tree" > "$archive_file"; then
                printf '%s\n' "error: failed to read untracked snapshot; stash retained at $stash_ref" >&2
                exit 1
            fi
            if ! tar -xf "$archive_file"; then
                printf '%s\n' "error: failed to restore untracked work; stash retained at $stash_ref" >&2
                exit 1
            fi
        fi

        if ! git stash drop "$stash_ref"; then
            printf '%s\n' "error: restored the pre-commit snapshot but could not drop $stash_ref" >&2
            exit 1
        fi
    fi

    rm -f "$patch_file" "$archive_file"
    exit "$hook_status"
}

trap restore_worktree EXIT HUP INT TERM

# hk 2.0.1's path-limited stash drops untracked paths before invoking Git.
# Snapshot every non-index path once, leaving the index/worktree staged view.
before_stash=$(git rev-parse --verify --quiet refs/stash 2>/dev/null || true)
set +e
git stash push --include-untracked --keep-index --message "jackin pre-commit"
stash_status=$?
set -e
after_stash=$(git rev-parse --verify --quiet refs/stash 2>/dev/null || true)

if [ "$after_stash" != "$before_stash" ]; then
    stash_ref='stash@{0}'
fi

if [ "$stash_status" -ne 0 ]; then
    printf '%s\n' "error: failed to create the pre-commit snapshot" >&2
    exit "$stash_status"
fi

set +e
mise x -- hk run pre-commit --from-hook "$@"
hook_status=$?
set -e
exit "$hook_status"

#!/bin/sh
# shellcheck disable=SC2016,SC2329 # Child shells expand positional arguments; traps invoke functions.
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

stash_oid=
snapshot_ref=
snapshot_published=0
clear_started=0
worktree_cleared=0
snapshot_git_dir=
snapshot_index_file=
snapshot_objects_dir=
untracked_index_file=
patch_file=
archive_file=
mode_file=
path_file=
untracked_path_file=

snapshot_git() {
    GIT_DIR=$snapshot_git_dir \
    GIT_WORK_TREE=$repo_root \
    GIT_INDEX_FILE=$snapshot_index_file \
    GIT_OBJECT_DIRECTORY=$snapshot_objects_dir \
        git "$@"
}

snapshot_index_git() {
    temporary_index=$1
    shift
    GIT_DIR=$snapshot_git_dir \
    GIT_WORK_TREE=$repo_root \
    GIT_INDEX_FILE=$temporary_index \
    GIT_OBJECT_DIRECTORY=$snapshot_objects_dir \
        git "$@"
}

copy_snapshot_config() {
    for config_key in \
        core.fileMode \
        core.ignoreCase \
        core.symlinks \
        core.precomposeUnicode \
        core.sparseCheckout \
        core.sparseCheckoutCone \
        user.name \
        user.email; do
        config_value=$(git config --get "$config_key" 2>/dev/null || true)
        if [ -n "$config_value" ]; then
            snapshot_git config "$config_key" "$config_value"
        fi
    done
}

cleanup_snapshot_storage() {
    if [ -n "$snapshot_git_dir" ]; then
        rm -rf "$snapshot_git_dir"
        snapshot_git_dir=
    fi
}

cleanup_snapshot_files() {
    for snapshot_file in \
        "$path_file" \
        "$untracked_path_file" \
        "$patch_file" \
        "$archive_file" \
        "$mode_file"; do
        if [ -n "$snapshot_file" ]; then
            rm -f "$snapshot_file"
        fi
    done
}

restore_modes() {
    if [ -n "$mode_file" ] && [ -s "$mode_file" ]; then
        if ! xargs -0 -n 2 sh -c '
            set -eu
            stash_oid=$0
            if [ "$#" -eq 0 ]; then
                exit 0
            fi
            if [ "$#" -ne 2 ]; then
                printf "%s\n" "error: malformed mode snapshot; stash retained at $stash_oid" >&2
                exit 1
            fi
            mode=$1
            path=$2
            if [ ! -e "$path" ] && [ ! -L "$path" ]; then
                printf "%s\n" "error: failed to restore mode for missing $path; stash retained at $stash_oid" >&2
                exit 1
            fi
            if [ -L "$path" ]; then
                exit 0
            fi
            if ! chmod "$mode" "$path"; then
                printf "%s\n" "error: failed to restore mode for $path; stash retained at $stash_oid" >&2
                exit 1
            fi
        ' "$stash_oid" < "$mode_file"; then
            return 1
        fi
    fi
}

record_modes() {
    paths_file=$1
    if ! xargs -0 -n 1 sh -c '
        set -eu
        mode_file=$0
        if [ "$#" -eq 0 ]; then
            exit 0
        fi
        if [ "$#" -ne 1 ]; then
            printf "%s\n" "error: malformed path snapshot" >&2
            exit 1
        fi
        relative_path=$1
        path="./$relative_path"
        if [ -L "$path" ] || [ ! -e "$path" ]; then
            exit 0
        fi
        mode=$(stat -f "%Lp" "$path" 2>/dev/null || stat -c "%a" "$path") || exit 1
        printf "%s\000%s\000" "$mode" "$path" >> "$mode_file"
    ' "$mode_file" < "$paths_file"; then
        return 1
    fi
}

verify_snapshot_ref() {
    current_snapshot=$(git rev-parse --verify --quiet "$snapshot_ref" 2>/dev/null || true)
    if [ "$current_snapshot" != "$stash_oid" ]; then
        printf '%s\n' "error: pre-commit snapshot ref changed; snapshot retained at $snapshot_ref ($stash_oid)" >&2
        return 1
    fi

    current_stash=$(git rev-parse --verify --quiet refs/stash 2>/dev/null || true)
    if [ "$current_stash" != "$before_stash" ]; then
        printf '%s\n' "error: refs/stash changed; snapshot retained at $snapshot_ref ($stash_oid)" >&2
        return 1
    fi
}

drop_snapshot() {
    if [ -n "$before_stash" ]; then
        printf 'start\nverify refs/stash %s\ndelete %s %s\nprepare\ncommit\n' \
            "$before_stash" "$snapshot_ref" "$stash_oid" |
            git update-ref --stdin >/dev/null
    else
        printf 'start\nverify refs/stash\ndelete %s %s\nprepare\ncommit\n' \
            "$snapshot_ref" "$stash_oid" |
            git update-ref --stdin >/dev/null
    fi
}

restore_worktree() {
    hook_status=$?
    trap - EXIT HUP INT TERM

    if [ "$snapshot_published" -eq 1 ]; then
        if ! verify_snapshot_ref; then
            cleanup_snapshot_files
            exit 1
        fi

        if [ "$clear_started" -eq 1 ] && [ "$worktree_cleared" -eq 0 ]; then
            if ! git clean -dfx --quiet || ! git restore --worktree -- .; then
                printf '%s\n' "error: failed to reset the pre-commit worktree; snapshot retained at $stash_oid" >&2
                cleanup_snapshot_files
                exit 1
            fi
        fi

        if [ "$clear_started" -eq 0 ]; then
            if ! drop_snapshot; then
                printf '%s\n' "error: snapshot was published but the worktree was not cleared; could not remove $snapshot_ref ($stash_oid)" >&2
                cleanup_snapshot_files
                exit 1
            fi
            cleanup_snapshot_files
            cleanup_snapshot_storage
            exit "$hook_status"
        fi

        patch_file=$(mktemp "${TMPDIR:-/tmp}/jackin-pre-commit.XXXXXX")
        if ! git diff --binary "$stash_oid^2" "$stash_oid" > "$patch_file"; then
            printf '%s\n' "error: failed to read the pre-commit snapshot; stash retained at $stash_oid" >&2
            cleanup_snapshot_files
            exit 1
        fi
        if [ -s "$patch_file" ] && ! git apply --binary --whitespace=nowarn "$patch_file"; then
            printf '%s\n' "error: failed to restore unstaged tracked work; stash retained at $stash_oid" >&2
            cleanup_snapshot_files
            exit 1
        fi

        untracked_tree=$(git rev-parse --verify --quiet "$stash_oid^3" 2>/dev/null || true)
        if [ -n "$untracked_tree" ]; then
            archive_file=$(mktemp "${TMPDIR:-/tmp}/jackin-pre-commit.XXXXXX")
            if ! git archive --format=tar "$untracked_tree" > "$archive_file"; then
                printf '%s\n' "error: failed to read untracked snapshot; stash retained at $stash_oid" >&2
                cleanup_snapshot_files
                exit 1
            fi
            if ! tar -xpf "$archive_file"; then
                printf '%s\n' "error: failed to restore untracked work; stash retained at $stash_oid" >&2
                cleanup_snapshot_files
                exit 1
            fi
        fi

        if ! restore_modes; then
            cleanup_snapshot_files
            exit 1
        fi

        if ! verify_snapshot_ref; then
            cleanup_snapshot_files
            exit 1
        fi
        if ! drop_snapshot; then
            printf '%s\n' "error: restored the pre-commit snapshot but could not remove $snapshot_ref ($stash_oid)" >&2
            cleanup_snapshot_files
            exit 1
        fi
    fi

    cleanup_snapshot_files
    cleanup_snapshot_storage
    exit "$hook_status"
}

trap restore_worktree EXIT HUP INT TERM

# hk 2.0.1's path-limited stash drops untracked paths before invoking Git.
# Snapshot every non-index path, including ignored files, leaving the index view.
# Git's stash ref is a shared reflog. Create the snapshot without changing the
# worktree, publish its OID under a private ref, and only then clear the
# worktree. Remove that ref with a refs/stash baseline check in the same CAS
# transaction.
mode_file=$(mktemp "${TMPDIR:-/tmp}/jackin-pre-commit.XXXXXX")
path_file=$(mktemp "${TMPDIR:-/tmp}/jackin-pre-commit.XXXXXX")
{
    git diff --name-only -z
    git ls-files --others --exclude-standard -z
    git ls-files --others --ignored --exclude-standard -z
} > "$path_file"
if ! record_modes "$path_file"; then
    printf '%s\n' 'error: failed to record pre-commit snapshot modes' >&2
    exit 1
fi

before_stash=$(git rev-parse --verify --quiet refs/stash 2>/dev/null || true)
snapshot_index_file=$(git rev-parse --git-path index)
case "$snapshot_index_file" in
    /*) ;;
    *) snapshot_index_file="$repo_root/$snapshot_index_file" ;;
esac
snapshot_objects_dir=$(git rev-parse --git-path objects)
case "$snapshot_objects_dir" in
    /*) ;;
    *) snapshot_objects_dir="$repo_root/$snapshot_objects_dir" ;;
esac
snapshot_git_dir=$(mktemp -d "${TMPDIR:-/tmp}/jackin-pre-commit-git.XXXXXX")
object_format=$(git rev-parse --show-object-format)
git init --bare --quiet --object-format="$object_format" "$snapshot_git_dir"
snapshot_git config core.bare false
copy_snapshot_config
head_oid=$(git rev-parse HEAD)
snapshot_git update-ref refs/heads/jackin-pre-commit "$head_oid"
snapshot_git symbolic-ref HEAD refs/heads/jackin-pre-commit

# `git stash push --all --keep-index` clears the worktree before this script
# can publish ownership of its OID. `git stash create` records tracked state
# without clearing it; add non-index paths to a temporary index and construct
# the optional third stash parent explicitly.
set +e
tracked_stash_oid=$(snapshot_git stash create "jackin pre-commit")
stash_status=$?
set -e
if [ "$stash_status" -ne 0 ]; then
    printf '%s\n' "error: failed to create the pre-commit snapshot" >&2
    exit "$stash_status"
fi

if [ -n "$tracked_stash_oid" ]; then
    index_oid=$(snapshot_git rev-parse "$tracked_stash_oid^2")
    worktree_tree=$(snapshot_git rev-parse "$tracked_stash_oid^{tree}")
else
    index_tree=$(snapshot_git write-tree)
    index_oid=$(printf '%s\n' 'index on jackin-pre-commit' |
        snapshot_git commit-tree "$index_tree" -p "$head_oid")
    worktree_tree=$(snapshot_git rev-parse "$head_oid^{tree}")
fi

untracked_path_file=$(mktemp "${TMPDIR:-/tmp}/jackin-pre-commit.XXXXXX")
{
    git ls-files --others --exclude-standard -z
    git ls-files --others --ignored --exclude-standard -z
} > "$untracked_path_file"

untracked_commit=
if [ -s "$untracked_path_file" ]; then
    untracked_index_file=$(mktemp "$snapshot_git_dir/index.XXXXXX")
    snapshot_index_git "$untracked_index_file" read-tree --empty
    snapshot_index_git "$untracked_index_file" \
        --literal-pathspecs add -f \
        --pathspec-from-file="$untracked_path_file" \
        --pathspec-file-nul
    untracked_tree=$(snapshot_index_git "$untracked_index_file" write-tree)
    untracked_commit=$(printf '%s\n' 'untracked files on jackin-pre-commit' |
        snapshot_git commit-tree "$untracked_tree")
fi

if [ -n "$untracked_commit" ]; then
    stash_oid=$(printf '%s\n' 'jackin pre-commit' |
        snapshot_git commit-tree "$worktree_tree" \
            -p "$head_oid" \
            -p "$index_oid" \
            -p "$untracked_commit")
else
    stash_oid=$tracked_stash_oid
fi

if [ -n "$stash_oid" ]; then
    snapshot_ref="refs/jackin/pre-commit-snapshot/$(basename "$snapshot_git_dir")"
    if ! printf 'start\ncreate %s %s\nprepare\ncommit\n' \
        "$snapshot_ref" "$stash_oid" | git update-ref --stdin >/dev/null; then
        printf '%s\n' "error: failed to publish the pre-commit snapshot; worktree was not cleared" >&2
        exit 1
    fi
    snapshot_published=1

    clear_started=1
    set +e
    git restore --worktree -- .
    clear_status=$?
    if [ "$clear_status" -eq 0 ]; then
        git clean -dfx --quiet
        clear_status=$?
    fi
    set -e
    if [ "$clear_status" -ne 0 ]; then
        printf '%s\n' "error: failed to clear the pre-commit worktree; snapshot retained at $snapshot_ref ($stash_oid)" >&2
        exit "$clear_status"
    fi
    worktree_cleared=1
    cleanup_snapshot_storage
fi

set +e
mise x -- hk run pre-commit --from-hook "$@"
hook_status=$?
set -e
exit "$hook_status"

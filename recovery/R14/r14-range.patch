From 0e089acd5d0974b3b04b7983e0200da07da24ad6 Mon Sep 17 00:00:00 2001
From: Alexey Zhokhov <alexey@zhokhov.com>
Date: Tue, 22 Sep 2026 22:10:02 +0800
Subject: [PATCH 1/3] ci: disable release mise auto-install

Co-authored-by: Codex <codex@openai.com>
Signed-off-by: Alexey Zhokhov <alexey@zhokhov.com>
(cherry picked from commit 7090d8c45c6cd72644dc66f0732a6b50c7167403)
Signed-off-by: Alexey Zhokhov <alexey@zhokhov.com>
---
 .github-gen/velnor-workflow.toml           | 7 +++++++
 .github/ci/.github-actions-generator-state | 2 +-
 .github/workflows/release.yml              | 4 ++++
 3 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/.github-gen/velnor-workflow.toml b/.github-gen/velnor-workflow.toml
index adfbaf8cac03d471a2320980baa1146d13d7eb3b..cc1352a2d08f1a6a06a84d41d005cc9627a091a3 100644
--- a/.github-gen/velnor-workflow.toml
+++ b/.github-gen/velnor-workflow.toml
@@ -230,6 +230,11 @@ timeout_minutes = 90
 [release.job.env]
 DEVELOPER_DIR = "/Applications/Xcode_26.6.app/Contents/Developer"
 MACOSX_DEPLOYMENT_TARGET = "26.0"
+# Keep release jobs fail-fast after the declared tool setup. The release
+# graph invokes mise tasks in the same job; allowing task-level auto-install
+# would silently rebuild the full toolset after the setup cache is saved.
+MISE_TASK_RUN_AUTO_INSTALL = "false"
+MISE_NOT_FOUND_AUTO_INSTALL = "false"
 
 [[release.job]]
 id = "sign"
@@ -249,6 +254,8 @@ attestations = "write"
 [release.job.env]
 DEVELOPER_DIR = "/Applications/Xcode_26.6.app/Contents/Developer"
 MACOSX_DEPLOYMENT_TARGET = "26.0"
+MISE_TASK_RUN_AUTO_INSTALL = "false"
+MISE_NOT_FOUND_AUTO_INSTALL = "false"
 DEVELOPER_ID_APPLICATION_P12_BASE64 = "${{ secrets.DEVELOPER_ID_APPLICATION_P12_BASE64 }}"
 DEVELOPER_ID_APPLICATION_P12_PASSWORD = "${{ secrets.DEVELOPER_ID_APPLICATION_P12_PASSWORD }}"
 APP_STORE_CONNECT_API_KEY_P8 = "${{ secrets.APP_STORE_CONNECT_API_KEY_P8 }}"
diff --git a/.github/ci/.github-actions-generator-state b/.github/ci/.github-actions-generator-state
index c9fe51aa50bc2ae820b4071116fb868fbcd915fd..8c04714f6efb4e6e08f6cef3dc2abe7a75eebbb0 100644
--- a/.github/ci/.github-actions-generator-state
+++ b/.github/ci/.github-actions-generator-state
@@ -19,7 +19,7 @@ generator	69
 .github/workflows/desktop-scheduled.yml	0fab7ec5efcff35a
 .github/workflows/maintenance.yml	5078302181cae2b1
 .github/workflows/nightly.yml	4478cd4ea5ab5dd7
-.github/workflows/release.yml	1aace61e7093c352
+.github/workflows/release.yml	934a164963404de4
 .github/workflows/renovate-upstream-sources.yml	aea51fd10f50526e
 config/fleet/velnor-host.env	d14b419216449423
 .github/CLAUDE.md	78a740c6ccf6937a
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 2a0a49b83e4bbd9512e1c6eda1c1b07ca145f7d1..e926a2dbe1a89f4d3feb5e3922357bfbf46a8af7 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -31,6 +31,8 @@ jobs:
     env:
       DEVELOPER_DIR: "/Applications/Xcode_26.6.app/Contents/Developer"
       MACOSX_DEPLOYMENT_TARGET: "26.0"
+      MISE_NOT_FOUND_AUTO_INSTALL: "false"
+      MISE_TASK_RUN_AUTO_INSTALL: "false"
     steps:
       - name: Checkout
         uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
@@ -69,6 +71,8 @@ jobs:
       EXPECTED_CERT_SHA256: "${{ vars.JACKIN_DEVELOPER_ID_CERT_SHA256 }}"
       EXPECTED_TEAM_ID: "${{ vars.JACKIN_DEVELOPER_ID_TEAM_ID }}"
       MACOSX_DEPLOYMENT_TARGET: "26.0"
+      MISE_NOT_FOUND_AUTO_INSTALL: "false"
+      MISE_TASK_RUN_AUTO_INSTALL: "false"
     steps:
       - name: Checkout
         uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

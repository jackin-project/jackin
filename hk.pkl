// Owner hk standard (mise + mbx + hk): identical base, plus the builtins this repository's stacks need.
// Top-level `steps` feed the `check`, `fix` and `pre-commit` hooks; `pre-push` and `security-audit` are custom hooks.
// Install owned hooks with `sh scripts/hooks-install`; run `hk run security-audit` directly or on a schedule.
// Every security-audit scanner selects its reviewed version with `mise exec --locked --`.
amends "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Builtins.pkl"

jobs = 2
fail_fast = false

steps {
  ["mise"] = Builtins.mise
  ["gitleaks"] = Builtins.gitleaks
  // `--all`: the root Cargo.toml is a virtual manifest (selected through rustfmt.toml), where a plain
  // `cargo fmt --manifest-path` fails with "Failed to find targets".
  ["cargo_fmt"] = (Builtins.cargo_fmt) {
    check { command = "bash \"$(git rev-parse --show-toplevel)/scripts/hk-cargo.sh\" \"$(pwd -P)/{{workspace_indicator}}\" fmt-check" }
    check_list_files { command = "bash \"$(git rev-parse --show-toplevel)/scripts/hk-cargo.sh\" \"$(pwd -P)/{{workspace_indicator}}\" fmt-files" }
    fix { command = "bash \"$(git rev-parse --show-toplevel)/scripts/hk-cargo.sh\" \"$(pwd -P)/{{workspace_indicator}}\" fmt-fix" }
  }
  // crates/tools/jackin-lints is outside the workspace and needs the pinned nightly with rustc-dev; it is built,
  // UI-tested and run by the native xtask via `mise run check:custom-lints`, which invokes
  // `cargo run --locked -p jackin-xtask -- custom-lints`, never by stable cargo.
  ["cargo_check"] = (Builtins.cargo_check) {
    workspace_indicator = "Cargo.toml"
    exclude = List("crates/tools/jackin-lints/**")
    check { command = "bash \"$(git rev-parse --show-toplevel)/scripts/hk-cargo.sh\" \"$(pwd -P)/{{workspace_indicator}}\" check" }
    fix { command = "bash \"$(git rev-parse --show-toplevel)/scripts/hk-cargo.sh\" \"$(pwd -P)/{{workspace_indicator}}\" check-fix" }
  }
  ["cargo_clippy"] = (Builtins.cargo_clippy) {
    exclude = List("crates/tools/jackin-lints/**")
    check { command = "bash \"$(git rev-parse --show-toplevel)/scripts/hk-cargo.sh\" \"$(pwd -P)/{{workspace_indicator}}\" clippy" }
    fix { command = "bash \"$(git rev-parse --show-toplevel)/scripts/hk-cargo.sh\" \"$(pwd -P)/{{workspace_indicator}}\" clippy-fix" }
  }
  // deny.toml governs the root workspace (as in CI). The fuzz/ crates and crates/tools/jackin-lints are separate
  // workspaces with their own lockfiles and path-wildcard fuzz dependencies outside that policy.
  ["cargo_deny"] = (Builtins.cargo_deny) { exclude = List("fuzz/**", "crates/tools/jackin-lints/**") }
  ["rust-toolchain-mirror"] {
    glob = List("mise.toml", "rust-toolchain.toml")
    check = "sh scripts/check-rust-toolchain-mirror.sh"
  }
  ["rumdl"] = (Builtins.rumdl) {
    check { command = "rumdl check --no-cache {{files}}" }
    check_diff { command = "rumdl check --no-cache --diff {{files}}" }
  }
  // Native jactionlint (velnor hard decision 10, the workflow lint contract's local run): check-only, because .github/
  // is generated by velnor-actions; the generated CI's flags, reading the generated .github/jactionlint.yaml.
  ["jactionlint"] = (Builtins.jactionlint) {
    fix = null
    check_diff = null
    check = "jactionlint --format gcc --strict-exit --no-online --shellcheck=shellcheck --pyflakes= {{files}}"
  }
  ["swiftlint"] {
    glob = "native/**/*.swift"
    condition = "exec('command -v swiftlint || true') != ''"
    check = "cd native && swiftlint lint --strict"
  }
  ["swift-format"] {
    glob = "native/**/*.swift"
    condition = "exec('command -v xcrun || true') != ''"
    check = "cd native && find Sources Tests UITests Tools Scripts -name '*.swift' ! -path '*/JackinUsageBindings/*' -print0 | xargs -0 xcrun swift-format lint --configuration .swift-format --strict --parallel"
    fix = "cd native && find Sources Tests UITests Tools Scripts -name '*.swift' ! -path '*/JackinUsageBindings/*' -print0 | xargs -0 xcrun swift-format format --configuration .swift-format --in-place --parallel"
  }
}

hooks {
  ["pre-commit"] {
    fix = false
    stage = false
    stash = "none"
    steps {
      ["kingfisher-staged"] { check = "kingfisher scan . --staged --no-validate --redact --no-update-check --baseline-file .kingfisher-baseline.yml" }
    }
  }
  ["pre-push"] {
    steps {
      ["betterleaks-history"] { check = "betterleaks git . --redact" }
    }
  }
  // Full history, all findings redacted. The kingfisher baseline holds reviewed placeholder/test-fixture findings with
  // written reasons; betterleaks and gitleaks read .betterleaksignore / .gitleaksignore.
  ["security-audit"] {
    steps {
      ["kingfisher-history"] { check = "mise exec --locked -- kingfisher scan . --git-history full --confidence low --no-validate --redact --no-update-check --baseline-file .kingfisher-baseline.yml" }
      ["betterleaks-history"] { check = "mise exec --locked -- betterleaks git . --redact" }
      ["gitleaks-history"] { check = "mise exec --locked -- gitleaks git . --redact --no-banner" }
    }
  }
}

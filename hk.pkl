// Git hooks for jackin. hk is pinned in mise.toml and mise.lock.
//
// Install once per checkout (idempotent):
//   mise install
//   hk install
//
// Rust formatting and linting use the hk builtins (https://hk.jdx.dev):
//   cargo-fmt    — `cargo fmt --manifest-path {{workspace_indicator}}`
//   cargo-clippy — `cargo clippy --manifest-path {{workspace_indicator}} -- -D warnings`
// Both run once per Cargo workspace. `hk check` and the pre-commit hook run
// them. `hk check --all` checks every matching file. `hk fix` applies fixes.
amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"

steps {
  ["cargo-fmt"] = Builtins.cargo_fmt
  ["cargo-clippy"] = (Builtins.cargo_clippy) {
    check = new CommandSpec {
      command = "cargo clippy --locked --manifest-path {{workspace_indicator}} --all-targets --all-features --quiet -- -D warnings"
      effect = "write"
    }
  }
  ["actionlint"] {
    glob = ".github/workflows/*.yml"
    check = "actionlint {{files}}"
  }
  ["swiftlint"] {
    glob = "native/**/*.swift"
    condition = "exec('command -v swiftlint || true') != ''"
    check = "cd native && swiftlint lint --strict"
  }
  ["swift-format"] {
    glob = "native/**/*.swift"
    condition = "exec('command -v xcrun || true') != ''"
    check = "cd native && find Sources Tests UITests Tools Scripts -name '*.swift' ! -path '*/JackinUsageBindings/*' -print0 | xargs -0 xcrun swift-format lint --configuration .swift-format --strict --parallel"
    fix = "cd native && find Sources Tests UITests Tools Scripts -name '*.swift' ! -path '*/JackinUsageBindings/*' -print0 | xargs -0 xcrun swift-format format --configuration .swift-format --in-place --parallel"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
  }
  ["pre-push"] {
    stash = "none"
  }
}

amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

jobs = 2
fail_fast = false

steps {
  ["mise"] = Builtins.mise
  ["gitleaks"] = (Builtins.gitleaks) {
    check = "tree=$(mktemp -d) && trap 'rm -rf \"$tree\"' EXIT && git checkout-index --all --prefix=\"$tree/\" && cd \"$tree\" && gitleaks dir --redact --verbose --no-banner ."
  }
  ["cargo_fmt"] {
    glob = List("**/*.rs", "rustfmt.toml")
    check = "cargo fmt --all --check"
    fix = "cargo fmt --all"
  }
  ["cargo_clippy"] {
    glob = List("**/*.rs", "**/Cargo.toml", "Cargo.lock", "clippy.toml")
    check = "cargo clippy --workspace --all-targets --all-features --locked -- -D warnings"
    fix = "cargo clippy --workspace --all-targets --all-features --locked --fix --allow-dirty --allow-staged -- -D warnings"
    check_first = false
  }
  ["xtask_repo_gates"] {
    check = "mise exec -- mbx +1.99.1 xtask ci --only comments,layers,pins,containers,errors"
  }
  ["rumdl"] = (Builtins.rumdl) {
    exclude = List("rewrite/**", "README.md")
    check { command = "rumdl check --no-cache {{files}}" }
    check_diff { command = "rumdl check --no-cache --diff {{files}}" }
  }
  ["jactionlint"] = (Builtins.jactionlint) {
    fix = null
    check_diff = null
    check = "jactionlint --config-file .github/jactionlint.yaml --format gcc --strict-exit --no-online --shellcheck=shellcheck --pyflakes= {{files}}"
  }
  ["zizmor"] {
    glob = ".github/workflows/*.yml"
    check = "zizmor --offline --no-progress --min-severity low {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    fix = false
    stage = false
    stash = "none"
    steps {
      ["kingfisher-staged"] { check = "kingfisher scan . --staged --no-validate --redact --no-update-check --baseline-file .kingfisher-baseline.yml" }
    }
  }
  ["pre-push"] {
    steps {
      ["betterleaks-history"] { check = "betterleaks git . --config .gitleaks.toml --redact --log-opts=\"HEAD --not --remotes\"" }
      ["xtask-ci"] { check = "mise run ci:fast" }
    }
  }
  ["security-audit"] {
    steps {
      ["kingfisher-history"] { check = "mise exec --locked -- kingfisher scan . --git-history full --confidence low --no-validate --redact --no-update-check --baseline-file .kingfisher-baseline.yml" }
      ["betterleaks-history"] { check = "mise exec --locked -- betterleaks git . --config .gitleaks.toml --redact" }
      ["gitleaks-history"] { check = "mise exec --locked -- gitleaks git . --redact --no-banner" }
    }
  }
}

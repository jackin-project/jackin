ision]\n    try:\n        subprocess.run(\n            [\n                jackin_binary,\n                \"usage\",\n                \"statusline\",\n                \"ingest\",\n                *scope_args,\n                \"--format\",\n                \"json\",\n                \"--data-dir\",\n                data_dir,\n            ],\n            input=bytes(captured),\n            stdout=subprocess.DEVNULL,\n            stderr=subprocess.DEVNULL,\n            timeout=2,\n            check=False,\n        )\n    except (OSError, subprocess.TimeoutExpired):\n        pass\nsys.exit(0)\n' 'printf existing' '/Users/donbeave/.local/share/jackin-claude-monitor-v3/bin/jackin' 'binding' 'binding-00000001' '1' '/tmp/jkin-installed-smoke-8fcydfe9/data'",

        "usage.input_tokens_details.cache_write_tokens_details.ttl_12h_tokens"
      ],
      "ordinary_input": "input_total - cache_read_subset - cache_write_subset",
      "output_total": "usage.output_tokens",
      "reasoning_subset": "usage.output_tokens_details.reasoning_tokens",
      "rules": [
        "Do not add reasoning tokens to output total.",
        "For GPT5.6 and later, cached/read and write counts disjoint; write classes sum cache_write_tokens.",
        "Earlier models have no separate cache-write charge: ordinary billed input=input_total-cache_read_subset.",
        "Missing write accounting for a paid-write model is unknown, not zero."
      ]
    },
    "claude_messages": {
      "ordinary_input": "usage.input_tokens",
      "cache_read": "usage.cache_read_input_tokens",
      "cache_write": "usage.cache_creation_input_tokens",
      "write_breakdown": [
        "usage.cache_creation.ephemeral_5m_input_tokens",
        "usage.cache_creation.ephemeral_1h_input_tokens"
      ],
      "total_prompt": "input_tokens + cache_read_input_tokens + cache_creation_input_tokens",
      "output_total": "usage.output_tokens",
      "reasoning_subset": "usage.output_tokens_details.thinking_tokens",
      "rules": [
        "Input classes disjoint.",
        "Reasoning is subset of output; missing split stays unknown.",
        "When usage.iterations is present, sum iterations; top-level omits compaction costs and must not be summed again."
      ]
    },
    "gemini_interactions": {
      "input_total": "usage.total_input_tokens",
      "cache_read_subset": "usage.total_cached_tokens",
      "ordinary_input": "total_input_tokens-total_cached_tokens",
      "visible_output": "usage.total_output_tokens",
      "reasoning_disjoint": "usage.total_thought_tokens",
      "priced_generation": "total_output_tokens + total_thought_tokens",
      "rules": [
        "Interactions output and thoughts are disjoint: documented example 62+171+297=530 total.",
        "Argon supports implicit caching only, not explicit storage objects.",
        "Do not use generateContent usageMetadata field names for Interactions."
      ]
    }
  },

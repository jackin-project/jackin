// MVP repair workflow fixture. Amends the versioned schema in
// Workflow.pkl; all relative input paths resolve from this file's
// directory. `HEAD` is an input selector resolved to an exact commit by
// the plan compiler before hashing, never stored as-is.

amends "Workflow.pkl"

task = "task.md"
references = new { "requirements.md" }

checks {
  bundle = "fixture-checks"
  argv = new {
    "sh"
    "/jackin/checks/check_add.sh"
    "/work/repo"
  }
}

backup {
  mode = "off"
}

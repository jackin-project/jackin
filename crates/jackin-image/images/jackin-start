set -u

run=/sandbox/.jackin/run
project=/sandbox/project

fail() {
    echo "jackin-start: $1" >&2
    exit 64
}

publish() {
    printf '%s\n' "$1" >"$run/state.tmp" && mv -f "$run/state.tmp" "$run/state"
}

park() {
    [ -t 0 ] && stty sane -echo
    return 0
}

check_env() {
    [ -f "$1" ] || return 0
    [ -r "$1" ] || {
        echo 0
        return 1
    }
    n=0
    line=
    while IFS= read -r line; do
        n=$((n + 1))
        case $line in
            'export '*=*) ;;
            *)
                echo "$n"
                return 1
                ;;
        esac
        rest=${line#export }
        name=${rest%%=*}
        case $name in
            '' | [0123456789]* | *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_]*)
                echo "$n"
                return 1
                ;;
        esac
        quoted=${rest#*=}
        case $quoted in
            \'*\') ;;
            *)
                echo "$n"
                return 1
                ;;
        esac
        inner=${quoted#\'}
        inner=${inner%\'}
        while :; do
            case $inner in
                *\'*) ;;
                *) break ;;
            esac
            after=${inner#*\'}
            case $after in
                \\\'\'*) inner=${after#\\\'\'} ;;
                *)
                    echo "$n"
                    return 1
                    ;;
            esac
        done
    done <"$1"
    [ -z "$line" ] || {
        echo $((n + 1))
        return 1
    }
    return 0
}

drain() {
    if [ -t 0 ]; then
        stty -icanon min 0 time 0
        dd bs=4096 of=/dev/null 2>/dev/null
        stty sane
    fi
    return 0
}

run_attempt() {
    attempt_id=$1
    shift
    drain
    if bad=$(check_env "$envfile"); then
        publish "running $attempt_id"
    else
        echo "jackin-start: $envfile is malformed at line $bad" >&2
        publish "exited $attempt_id 65"
        park
        return 0
    fi
    rc=0
    (
        [ ! -f "$envfile" ] || . "$envfile"
        cd "$project" || exit 66
        exec "$@"
    ) || rc=$?
    publish "exited $attempt_id $rc"
    park
    printf '\r\033[0m\033[?25hjackin-start: %s exited with code %s (attempt %s)\r\n' "${1##*/}" "$rc" "$attempt_id"
}

[ "$#" -gt 0 ] || fail "missing agent command"

case ${JACKIN_LAUNCH_ID:-} in
    '' | .* | *[!A-Za-z0-9._-]*) fail "JACKIN_LAUNCH_ID is missing or invalid" ;;
esac

envfile=/sandbox/.jackin/env-$JACKIN_LAUNCH_ID

trap : INT TERM HUP QUIT TSTP

park
mkdir -p "$run"
rm -f "$run/state" "$run/state.tmp" "$run/start" "$run/start.tmp"
publish waiting

last=0
while :; do
    attempt=
    [ -f "$run/start" ] && IFS= read -r attempt 2>/dev/null <"$run/start"
    case $attempt in
        '' | 0* | *[!0-9]* | ???????????????????*) attempt= ;;
    esac
    if [ -z "$attempt" ] || [ "$attempt" -le "$last" ]; then
        sleep 0.5 || :
        continue
    fi

    last=$attempt
    run_attempt "$attempt" "$@"
done

set -u

run=/sandbox/.jackin/run
project=/sandbox/project
bin_dir=/usr/local/bin
environ_file=/proc/$$/environ

fail() {
    echo "jackin-start: $1" >&2
    exit 64
}

publish() {
    printf '%s\n' "$1" >"$run/state.tmp" && mv -f "$run/state.tmp" "$run/state"
}

park() {
    [ -t 0 ] && stty sane -echo
    return 0
}

check_env() {
    [ -f "$1" ] || return 0
    [ -r "$1" ] || {
        echo 0
        return 1
    }
    n=0
    line=
    while IFS= read -r line; do
        n=$((n + 1))
        case $line in
            'export '*=*) ;;
            *)
                echo "$n"
                return 1
                ;;
        esac
        rest=${line#export }
        name=${rest%%=*}
        case $name in
            '' | [0123456789]* | *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_]*)
                echo "$n"
                return 1
                ;;
        esac
        quoted=${rest#*=}
        case $quoted in
            \'*\') ;;
            *)
                echo "$n"
                return 1
                ;;
        esac
        inner=${quoted#\'}
        inner=${inner%\'}
        while :; do
            case $inner in
                *\'*) ;;
                *) break ;;
            esac
            after=${inner#*\'}
            case $after in
                \\\'\'*) inner=${after#\\\'\'} ;;
                *)
                    echo "$n"
                    return 1
                    ;;
            esac
        done
    done <"$1"
    [ -z "$line" ] || {
        echo $((n + 1))
        return 1
    }
    return 0
}

kinds() {
    LC_ALL=C /usr/bin/awk -v section="$1" '
        function credential(name,   word) {
            word = name
            gsub(/[^A-Za-z0-9_]/, "_", word)
            return name != "SSH_AUTH_SOCK" && word ~ /(^|_)(KEY|TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIALS?|AUTH)(_|$)/
        }
        function add(line,   i) {
            for (i = 0; i < count; i++) if (lines[i] == line) return
            lines[count++] = line
        }
        BEGIN {
            for (name in ENVIRON) {
                if (!credential(name)) continue
                value = ENVIRON[name]
                kind = "other"
                if (value == "") kind = "empty"
                else if (index(value, "\n") == 0 && value ~ /^openshell:resolve:/) kind = "placeholder"
                if (name !~ /^[A-Za-z_][A-Za-z0-9_]*$/) { name = "INVALID_NAME"; kind = "other" }
                add(section " " name " " kind)
            }
        }
        {
            eq = index($0, "=")
            if (eq > 1) {
                name = substr($0, 1, eq - 1)
                if (name !~ /^[A-Za-z_][A-Za-z0-9_]*$/ && credential(name)) add(section " INVALID_NAME other")
            }
        }
        END {
            for (i = 1; i < count; i++) {
                held = lines[i]
                for (j = i - 1; j >= 0 && lines[j] > held; j--) lines[j + 1] = lines[j]
                lines[j + 1] = held
            }
            for (i = 0; i < count; i++) print lines[i]
        }'
}

startup_kinds() {
    if [ -r "$environ_file" ]; then
        /usr/bin/tr '\0' '\n' <"$environ_file" 2>/dev/null | kinds main
    else
        kinds main </dev/null
    fi
}

write_record() {
    [ "$main_ok" = 1 ] || return 0
    {
        printf 'jackin-env-kinds 1\nattempt %s\n' "$1"
        [ -z "$main_lines" ] || printf '%s\n' "$main_lines"
        [ -z "$2" ] || printf '%s\n' "$2"
    } >"$run/env-kinds.tmp" && /bin/mv -f "$run/env-kinds.tmp" "$run/env-kinds"
    return 0
}

record_codex() {
    [ "$main_ok" = 1 ] || return 0
    codex_lines=$(kinds codex </dev/null) || return 0
    write_record "$1" "$codex_lines"
}

drain() {
    if [ -t 0 ]; then
        stty -icanon min 0 time 0
        dd bs=4096 of=/dev/null 2>/dev/null
        stty sane
    fi
    return 0
}

run_attempt() {
    attempt_id=$1
    shift
    drain
    if bad=$(check_env "$envfile"); then
        publish "running $attempt_id"
    else
        case $bad in
            0) echo "jackin-start: $envfile is not readable" >&2 ;;
            *) echo "jackin-start: $envfile is malformed at line $bad" >&2 ;;
        esac
        write_record "$attempt_id" ""
        publish "exited $attempt_id 65"
        park
        return 0
    fi
    rc=0
    (
        [ ! -f "$envfile" ] || . "$envfile"
        cd "$project" || exit 66
        record_codex "$attempt_id"
        exec "$@"
    ) || rc=$?
    publish "exited $attempt_id $rc"
    park
    printf '\r\033[0m\033[?25hjackin-start: %s exited with code %s (attempt %s)\r\n' "${1##*/}" "$rc" "$attempt_id"
}

[ "$#" -gt 0 ] && [ -n "$1" ] || fail "missing agent command"

case $1 in
    */*) ;;
    *)
        program=$bin_dir/$1
        shift
        set -- "$program" "$@"
        ;;
esac

case ${JACKIN_LAUNCH_ID:-} in
    '' | .* | *[!A-Za-z0-9._-]*) fail "JACKIN_LAUNCH_ID is missing or invalid" ;;
esac

envfile=/sandbox/.jackin/env-$JACKIN_LAUNCH_ID

trap : INT TERM HUP QUIT TSTP

park
mkdir -p "$run"
rm -f "$run/state" "$run/state.tmp" "$run/start" "$run/start.tmp" "$run/env-kinds" "$run/env-kinds.tmp"
main_ok=0
main_lines=
if main_lines=$(startup_kinds); then
    main_ok=1
else
    main_lines=
fi
write_record 0 ""
publish waiting

last=0
while :; do
    attempt=
    [ -f "$run/start" ] && IFS= read -r attempt 2>/dev/null <"$run/start"
    case $attempt in
        '' | 0* | *[!0-9]* | ???????????????????*) attempt= ;;
    esac
    if [ -z "$attempt" ] || [ "$attempt" -ne $((last + 1)) ]; then
        sleep 0.5 || :
        continue
    fi

    last=$attempt
    run_attempt "$attempt" "$@"
done
